        event_15 [label="[INFO]\n33:41 INFO  User found: id=1..."];
    }
    subgraph "cluster_node-03" {
        label="Node: node-03";
        color=gray; style=dashed;
        event_16 [label="[INFO]\n33:41 INFO  Logging request ..."];
        event_17 [label="[INFO]\n33:41 DEBUG  Log entry saved..."];
