digraph G {
    rankdir=LR;
    node [shape=box, fontname="Courier", fontsize=10];
    edge [color="#2b579a", arrowhead=normal, arrowsize=0.8];

    subgraph "cluster_node-01" {
        label="Node: node-01";
        color=gray; style=dashed;
        event_0 [label="[INFO]\n33:39 INFO  Request received..."];
        event_1 [label="[INFO]\n33:39 INFO  Calling node-02 ..."];
        event_2 [label="[INFO]\n33:39 INFO  Received respons..."];
        event_3 [label="[INFO]\n33:39 INFO  Sending result t..."];
        event_4 [label="[INFO]\n33:39 INFO  Request complete..."];
        event_5 [label="[INFO]\n33:39 INFO  Request received..."];
        event_6 [label="[INFO]\n33:39 INFO  Calling node-02 ..."];
        event_7 [label="[INFO]\n33:39 INFO  Received respons..."];
        event_8 [label="[INFO]\n33:40 INFO  Sending result t..."];
        event_9 [label="[INFO]\n33:40 INFO  Request complete..."];
    }
    subgraph "cluster_node-02" {
        label="Node: node-02";
        color=gray; style=dashed;
        event_10 [label="[INFO]\n33:40 INFO  Processing user ..."];
